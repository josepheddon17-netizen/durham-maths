\section{Product Rules}

\begin{proposition}[Product Rules]
  If \(f, g: \mathbb{R}^3 \rightarrow \mathbb{R}\) are scalar fields, and \(\boldsymbol{f}, \boldsymbol{g}: \mathbb{R}^3 \rightarrow \mathbb{R}^3\) are vector fields, all \(C^1\), then
\begin{itemize}
\item[(i)] \(\boldsymbol{\nabla}(f g) \equiv g \boldsymbol{\nabla} f+f \boldsymbol{\nabla} g\),
\item[(ii)] \(\boldsymbol{\nabla} \cdot(g \boldsymbol{f}) \equiv(\boldsymbol{\nabla} g) \cdot \boldsymbol{f}+g \boldsymbol{\nabla} \cdot \boldsymbol{f}\),
\item[(iii)] \(\boldsymbol{\nabla} \cdot(\boldsymbol{f} \times \boldsymbol{g}) \equiv \boldsymbol{g} \cdot(\boldsymbol{\nabla} \times \boldsymbol{f})-\boldsymbol{f} \cdot(\boldsymbol{\nabla} \times \boldsymbol{g})\),
\item[(iv)] \(\boldsymbol{\nabla} \times(g \boldsymbol{f}) \equiv g(\boldsymbol{\nabla} \times \boldsymbol{f})+(\boldsymbol{\nabla} g) \times \boldsymbol{f}\),
\item[(v)] \(\boldsymbol{\nabla} \times(\boldsymbol{f} \times \boldsymbol{g}) \equiv(\boldsymbol{g} \cdot \boldsymbol{\nabla}) \boldsymbol{f}-(\boldsymbol{f} \cdot \boldsymbol{\nabla}) \boldsymbol{g}+\boldsymbol{f}(\boldsymbol{\nabla} \cdot \boldsymbol{g})-\boldsymbol{g}(\boldsymbol{\nabla} \cdot \boldsymbol{f})\).
\item[(vi)] \(\nabla(f \cdot g) \equiv(g \cdot \nabla) f+(f \cdot \nabla) g+f \times(\nabla \times g)+g \times(\nabla \times f)\).
\end{itemize}
\end{proposition}

